<!-- ANNOUNCEMENT BAR -->
{{#unless page-css }}
    <link rel="stylesheet" href="sections/new/announcement/announcement-bar.css" />
{{/unless}}
<div id="announcement-bar" class="announcement-bar">
    <div class="announcement-bar-content">
        <div
            class="c-swiper"
            data-swiper='{
                "slidesPerView": 1,
                "spaceBetween": 0,
                "loop": true,
                "autoplay": {
                    "delay": 3000,
                    "pauseOnMouseEnter": true
                }
            }'
        >
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <a class="announcement-bar-link" href="#">
                        <p><strong>Limited Time Memorial Day Sale</strong> &ndash; up&nbsp;to&nbsp;40%&nbsp;off</p>
                        <span>Shop Now</span>
                    </a>
                </div>
                <div class="swiper-slide">
                    <div class="announcement-bar-offer-countdown">
                        <div class="container">
                            <p style="--colorize-color_: #ff5429;"><a href="#">Limited Time Memorial Day Sale</a> &ndash; up&nbsp;to&nbsp;40%&nbsp;off</p>
                            {{> e-countdown
                                color='style="--colorize-color: #ff5429;"'
                            }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce('countdown', 'assets/js-new/countdown.js');
    });
</script>
<!-- ANNOUNCEMENT BAR END -->
