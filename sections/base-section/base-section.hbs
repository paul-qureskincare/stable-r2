<!-- BASE SECTION -->
{{#unless page-css }}
    <link rel="stylesheet" href="sections/base-section/base-section.css" />
{{/unless}}
<section class="base-section {{ classes }}" {{#if id }}id="{{ id }}"{{/if}}>
    <div class="container">
        <article>
            <h2>{{ title }}</h2>
            {{!-- Simple image --}}
            {{#if picture }}
                <picture>
                    <img src="{{ picture }}" alt="{{ title }}" />
                </picture>
            {{/if}}
            {{!-- Video with text --}}
            {{#if video }}
                {{#parseJson video }}
                    <figure class="lvideo" data-url="{{ url }}">
                        <picture>
                            <img src="{{ picture }}" alt="{{ title }}" />
                        </picture>
                        <figcaption>
                            <strong>{{ label-main }}</strong>
                            {{ label-secondary }}
                        </figcaption>
                    </figure>
                {{/parseJson}}
            {{/if}}
            {{#if c-wistia }}
                {{> c-wistia
                    id=c-wistia
                    inline=c-wistia-inline
                    autoplay=true
                    hide-panel=c-wistia-hide-panel
                    custom=c-wistia-custom
                }}
            {{/if}}
            {{#if features-list }}
                {{{ features-list }}}
            {{/if}}
            <div>
                {{> @partial-block }}
            </div>
            {{#if percent-list }}
                {{> c-percent-list
                    list=percent-list
                    columns=true
                }}
            {{/if}}
            {{#if button }}
                <a href="#" class="btn btn--primary">{{ button }}</a>
            {{/if}}
            {{#if pill-badge }}
                <div class="e-pill-badge">
                    <span class="e-checkmark"></span>
                    Dermatologist Reviewed
                </div>
            {{/if}}
            {{#if ingredients }}
                <button class="btn btn--primary-grey" type="button" onclick="fullIngredient.showModal()">View Full Ingredient List</button>
                <dialog class="c-dialog" id="fullIngredient">
                    <div class="c-dialog__content">
                        <p><strong>Dermal Mist Ingredients</strong></p>
                        <p>Water (aqua)*, Chrysanthellum indicum flower water, sodium chloride, sodium phosphate, disodium phosphate, hypochlorous acid. *Ultra pure water.</p>
                        <button type="button" class="btn-close" onclick="fullIngredient.close()">
                            {{> e-icon icon="cross"}}
                        </button>
                    </div>
                </dialog>
            {{/if}}
            {{#if buy-block }}
                <div class="c-buy-block">
                    {{> c-order-button button="BUY NOW & SAVE UP TO 43%" }}
                    {{> c-certified-box }}
                    <ul class="e-features-list">
                        <li>
                            {{> e-icon icon="guarantee" }}
                            30-Day Money-Back Guarantee
                        </li>
                        <li>
                            {{> e-icon icon="shipping-order" }}
                            Free Shipping over {$dyn}
                        </li>
                    </ul>
                </div>
            {{/if}}
            {{#if custom-block }}
                {{{ custom-block }}}
            {{/if}}
        </article>
        {{#if readStudyDetails }}
            {{#> c-dialog
                classes="c-dialog--right-side"
                id="readStudyDetails"
                disclaimer="*Testing conducted by an independent laboratory. Results based on user perception and instrumental measurements of daily use over 6 weeks."
            }}
                <h6>Clinically Proven Benefits</h6>
                <p>An independent user study with 30 participants, supported by third-party TEWL measurements, showed improvements in measured skin barrier after 6 weeks of daily use of the Qure Daily Cleansing Gel.</p>
                <img src="assets/images/cleanser/cleanser-metrics-image-1.webp" alt="Clinically Proven Benefits" />
            {{/c-dialog }}
        {{/if}}
    </div>
</section>
<!-- BASE SECTION END -->
