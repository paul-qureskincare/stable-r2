<!-- HERO PRODUCT -->
{{#unless page-css }}
<link rel="stylesheet" href="sections/hero-product/hero-product.css" />
{{/unless}}
<section class="hero-product {{ classes }}" {{#if id }}id="{{ id }}"{{ else }}id="hero-product"{{/if }}>
    <div class="hero-product__container container">
        {{> @partial-block}}
    </div>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce('countdown', 'assets/js/countdown.js');
        loadScriptOnce('wistia-popup', 'assets/js/wistia-popup.js');
        loadScriptOnce('wistia-script', 'https://fast.wistia.com/assets/external/E-v1.js');
        loadScriptOnce('gallery-sticky-video', 'assets/js/gallery-sticky-video.js');
        loadScriptOnce('subscription-option', 'sections/hero-product/js/subscription-option.js');
    });
</script>
<!-- HERO PRODUCT END -->
