<!-- TRUSTED REVIEWS -->
{{#unless page-css }}
<link rel="stylesheet" href="sections/trusted-reviews/trusted-reviews.css" />
{{/unless}}
<section class="
        trusted-reviews
        {{#if trustpilot }}trusted-reviews--trustpilot{{/if }}
        {{ classes }}
    "
    {{#if id }}id="{{ id }}"{{/if}}
>
    <div class="container">
        {{#if trustpilot }}{{> e-icon icon="qure"}}{{/if }}
        <h2>{{ title }}</h2>
        {{#if trustpilot }}
            <div class="trustpilot-rating">
                <div class="trustpilot-rating__stars">
                    <a href="#">Excellent</a>
                    <div class="e-rating-stars" style="--rating: 4.7;"></div>
                </div>
                <div class="trustpilot-rating__rating">
                    <a href="#">Based on 4.8/5</a> reviews
                    <img src="assets/images/trustpilot.webp" alt="Trustpilot" />
                </div>
            </div>
            <p class="e-disclaimer">
                Based on individual user experience. Results may vary.
            </p>
        {{/if }}
        <div
            class="c-swiper"
            data-swiper='{
                "slidesPerView": 1.1,
                "spaceBetween": 16,
                "loop": false,
                "pagination": {
                    "el": ".c-swiper-pagination",
                    "type": "custom"
                },
                "navigation": {
                    "prevEl": ".c-swiper-button-prev",
                    "nextEl": ".c-swiper-button-next"
                },
                "breakpoints": {
                    "768": {
                        "slidesPerView": 2
                    },
                    "992": {
                        "spaceBetween": 24,
                        "slidesPerView": {{#if trustpilot }}3.3{{ else }}3{{/if }}
                    }
                }
            }'
        >
            <div class="swiper-wrapper">
                {{> @partial-block }}
            </div>
            <div class="c-swiper-nav">
                <button class="c-swiper-button-prev"></button>
                <div class="c-swiper-pagination"></div>
                <button class="c-swiper-button-next"></button>
            </div>
        </div>
        {{#if button }}
            <a class="btn btn--primary" href="#">{{ button }}</a>
        {{/if}}
        {{#if features-list }}
            <ul class="e-features-list">
                <li>
                    {{> e-icon icon="guarantee" }}
                    90-Day Money-Back Guarantee
                </li>
                <li>
                    {{> e-icon icon="shipping-order" }}
                    Free Shipping over {$dyn}
                </li>
            </ul>
        {{/if}}
    </div>
</section>
<!-- TRUSTED REVIEWS END -->
