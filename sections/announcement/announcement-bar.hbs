                    "delay": 3000,
                    "pauseOnMouseEnter": true
                }
            }'
        >
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <a class="announcement-bar-link" href="#">
                        <p><strong>Limited Time Memorial Day Sale</strong> &ndash; up&nbsp;to&nbsp;40%&nbsp;off</p>
                        <span>Shop Now</span>
                    </a>
                </div>
                <div class="swiper-slide">
                    <div class="announcement-bar-offer-countdown">
