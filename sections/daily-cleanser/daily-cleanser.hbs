<!-- DAILY CLEANSER -->
{{#unless page-css }}
    <link rel="stylesheet" href="sections/daily-cleanser/daily-cleanser.css" />
{{/unless}}
<section class="daily-cleanser">
    <picture>
        <source media="(min-width:768px)" srcset="assets/images/cleanser/daily-cleanser-bg.webp" />
        <img src="assets/images/cleanser/daily-cleanser-bg-mob.webp" alt="Daily Cleanser" />
    </picture>
    <div class="container">
        <article>
            <div class="e-pill-badge e-pill-badge--xs e-pill-badge--fill">NEW</div>
            <h3>Daily Cleanser</h3>
            <p>50% Glycerin. <strong>No Dryness.</strong> No Tightness.</p>
            <a class="btn btn--primary" href="#">Buy Now</a>
        </article>
    </div>
    <div class="free-gift">
        <div class="e-pill-badge e-pill-badge--fill">Free Gift</div>
        <img src="assets/images/cleanser/daily-cleanser-gift.webp" alt="Free Gift" />
    </div>
</section>
<!-- DAILY CLEANSER END -->
