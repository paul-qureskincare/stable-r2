<!-- BASE SLIDER -->
{{#unless page-css }}
    <link rel="stylesheet" href="sections/base-slider/base-slider.css" />
{{/unless}}
<section class="base-slider {{ classes }}" {{#if id }}id="{{ id }}"{{/if}}>
    <div class="container">
        {{#if title }}
            <h2>{{ title }}</h2>
        {{/if}}
        {{> @partial-block }}
        {{#if button }}
            <a class="btn btn--primary" href="#">{{ button }}</a>
        {{/if}}
    </div>
</section>
<!-- BASE SLIDER END -->
