<!-- HOW TO HELMET -->
{{#unless page-css }}
    <link rel="stylesheet" href="sections/how-to-helmet/how-to-helmet.css" />
{{/unless}}
<section class="how-to-helmet {{ classes }}">
    <div class="container">
        <article>
            <h2>{{ title }}</h2>
            {{#if video }}
                {{> c-wistia
                    id=video
                    custom='
                        <div class="c-wistia__link">
                            <span>Watch the video</span>
                            <i class="e-icon e-icon-watch"></i>
                        </div>
                    '
                }}
            {{/if }}
        </article>
    </div>
    <div class="container">
        {{> @partial-block}}
    </div>
</section>
<!-- HOW TO HELMET END -->
