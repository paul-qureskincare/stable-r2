    {{!-- WHY-IT-WORK --}}
    <div class="helper-sections__group" id="section-why-it-work">
        <h2 class="helper-sections__title">why-it-work</h2>
        <div class="helper-sections__variant">
            <div class="helper-sections__label"><em>base (no modifier)</em><small>page.led-mask-offer-2 · used 2×</small></div>
            {{#> why-it-work id="how_it_works" }}
                <div class="why-it-work__header">
                    <h2>How It Works</h2>
                    <ul class="e-pill-tabs" role="tablist">
                        <li>
                            <button
                                class="active"
                                type="button"
                                data-bs-toggle="tab"
                                data-bs-target="#why-it-work-rejuvenating"
                            >
                                Skin Rejuvenating
                            </button>
                        </li>
                        <li>
                            <button
                                type="button"
                                data-bs-toggle="tab"
                                data-bs-target="#why-it-work-clearing"
                            >
                                Skin Clearing
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="why-it-work__content show" id="why-it-work-rejuvenating">
                    <figure>
                        <figcaption>The Q-Rejuvalight Pro LED mask uses 5 light wavelengths and two modes for customizable skincare. Our FDA-cleared device targets your skin's needs.</figcaption>
                        <img src="assets/images/how-it-works/mask_aging.webp" alt="Q-Rejuvalight Pro LED mask" />
                    </figure>
                    <article>
                        <h6>Skin Rejuvenating Mode</h6>
                        <div>
                            <p>On Skin Rejuvenating Mode, red and infrared wavelengths work together to help improve the appearance of skin texture and firmness. </p>
                            <p>Red light helps improve the look of skin smoothness and radiance. Deep red and infrared light work at different depths of the skin’s surface to help improve the look of wrinkles over time.</p>
                        </div>
                        <ul class="e-scale">
                            <li style="--graduation-color: #840d43">Infrared <span>(880 nm)</span></li>
                            <li style="--graduation-color: #b80e0d">Deep Red <span>(660 nm)</span></li>
                            <li style="--graduation-color: #f5181e">Red <span>(630 nm)</span></li>
                            <li style="--graduation-color: #fd8e15">Amber <span>(605 nm)</span></li>
                        </ul>
                    </article>
                </div>
                <div class="why-it-work__content" id="why-it-work-clearing">
                    <figure>
                        <figcaption>The Q-Rejuvalight Pro LED mask uses 5 light wavelengths and two modes for customizable skincare. Our FDA-cleared device targets your skin's needs.</figcaption>
                        <img src="assets/images/how-it-works/mask_breakout.webp" alt="Q-Rejuvalight Pro LED mask" />
                    </figure>
                    <article>
                        <h6>Skin Clearing Mode</h6>
                        <div>
                            <p>Our Skin Clearing Mode combines blue and red light wavelengths. Blue (415 nm) helps with mild-to-moderate acne, while red (630 nm) helps calm and soothe the appearance of irritated skin.</p>
                            <p>Together, these wavelengths help improve the appearance of breakouts, support clearer-looking skin, and promote a balanced, healthier-looking complexion.</p>
                        </div>
                        <ul class="e-scale">
                            <li style="--graduation-color: #2b5aa2">Blue <span>(415 nm)</span></li>
                            <li style="--graduation-color: #f5181e">Red <span>(630 nm)</span></li>
                        </ul>
                    </article>
                </div>
                <div class="why-it-work__accordion">
                    <hr />
                    {{> c-accordion
                        list='[
                            {
                                "summary": "Technical specifications",
                                "text": "
                                    <p>
                                        <strong>TREATMENT TIME: </strong> 3 minutes<br />
                                        <strong>CERTIFICATES: </strong> FDA, TGA, CE, UKCA<br />
                                        <strong>OPERATION: </strong>Wireless, hands-free<br />
                                        <strong>WAVELENGTH: </strong>415nm (Blue), 605nm (Amber), 630nm (Red), 660nm (Deep Red), 880nm (Infrared)<br />
                                        <strong>TREATMENT TIME: </strong> 2 hours<br />
                                        <strong>CHARGING TIME: </strong> 3 minutes<br />
                                        <strong>LEDs: </strong> 160 dual core
                                    </p>
                                "
                            },
                            {
                                "summary": "Treatment details",
                                "text": "
                                    <p>
                                        <strong>USE: </strong> Use daily after cleansing, before topical skincare<br />
                                        <strong>PRO-AGING TREATMENT: </strong> 415nm (Blue), 605nm (Amber), 630nm (Red), 660nm (Deep Red), 880nm (Infrared)<br />
                                        <strong>ANTI-BREAKOUT TREATMENT: </strong> 415nm (Blue), 630nm (Red)<br />
                                        <strong>CUSTOMIZED TREATMENT: </strong> Choose treatment modes for each facial area via app<br />
                                        <strong>Skin Type: </strong>Most suitable for Fitzpatrick Skin Types I-IV
                                    </p>
                                "
                            }
                        ]'
                    }}
                </div>
            {{/why-it-work }}
        </div>
    </div>

