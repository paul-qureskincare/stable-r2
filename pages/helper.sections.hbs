    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var select = document.querySelector(".helper-sections__select");
            var input = select.querySelector(".helper-sections__search");
            var items = select.querySelectorAll("a");
            var empty = select.querySelector(".helper-sections__empty");
            function filter() {
                var q = input.value.trim().toLowerCase(), found = 0;
                items.forEach(function (a) {
                    var show = a.dataset.name.indexOf(q) !== -1;
                    a.parentNode.hidden = !show;
                    if (show) found++;
                });
                empty.hidden = found > 0;
            }
            input.addEventListener("focus", function () { select.classList.add("is-open"); });
            input.addEventListener("input", function () { select.classList.add("is-open"); filter(); });
            input.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { select.classList.remove("is-open"); input.blur(); }
                if (e.key === "Enter") {
                    var first = Array.prototype.find.call(items, function (a) { return !a.parentNode.hidden; });
                    if (first) first.click();
                }
            });
            select.addEventListener("click", function (e) {
                if (e.target.closest("a")) { select.classList.remove("is-open"); input.value = ""; filter(); }
            });
            document.addEventListener("click", function (e) {
                if (!select.contains(e.target)) select.classList.remove("is-open");
            });
        });
    </script>
    <button class="helper-sections__top" type="button" aria-label="Back to top" hidden>&uarr;</button>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var btn = document.querySelector(".helper-sections__top");
            function toggle() { btn.hidden = window.scrollY < 400; }
            window.addEventListener("scroll", toggle, { passive: true });
            btn.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: "smooth" }); });
            toggle();
        });
    </script>

