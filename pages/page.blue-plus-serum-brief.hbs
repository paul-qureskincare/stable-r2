{{#> default
    title="Blue+ Face Serum Brief"
    body-class="page.blue-plus-serum-brief"
    page-css=true
}}
    <!-- ACROSS IMAGE BANNER -->
    {{!-- <link rel="stylesheet" href="sections/across-image-banner/across-image-banner.css" /> --}}
    <section class="across-image-banner across-image-banner--hero across-image-banner--reverse">
        <picture>
            <source media="(min-width:768px)" srcset="assets/images/page-banner/blue-plus-serum.webp" />
            <img src="assets/images/page-banner/blue-plus-serum-mob.webp" alt="Blue+ Face Serum Creative Content Guide" />
        </picture>
        <div class="container">
            <article>
                <h1>Blue+ Face Serum Creative Content Guide</h1>
            </article>
        </div>
    </section>
    <!-- ACROSS IMAGE BANNER END -->

    <!-- INTRO SECTION -->
    {{!-- <link rel="stylesheet" href="sections/intro-section/intro-section.css" /> --}}
    <section class="intro-section">
        <div class="container">
            <article>
                <p><strong>Discover how to make the most of Qure's Blue+ Face Serum with our creative content guide.</strong></p>
                <p>This brief will help you craft engaging content that shows how Blue+ works with the Q-Rejuvalight Pro LED Mask to amplify results from every LED session.</p>
            </article>
        </div>
    </section>
    <!-- INTRO SECTION END -->

    <!-- GUIDE MENU -->
    <div class="shopify-section shopify-section--guide-menu">
        {{!-- <link rel="stylesheet" href="sections/guide-menu/guide-menu.css" /> --}}
        <section class="guide-menu">
            <div class="container">
                <div class="guide-menu__select">
                    <select name="guide-select" id="guide-select">
                        <option value="" selected disabled>Product Information</option>
                        <option value="product-information">Product Information</option>
                        <option value="usage-instructions">Usage Instructions</option>
                        <option value="product-claims">Product Claims</option>
                        <option value="content-requirements">Content Requirements</option>
                        <option value="creative-direction">Creative Direction</option>
                        <option value="content-examples">Content Examples</option>
                    </select>
                </div>
                <div class="guide-menu__list">
                    <p>Contents</p>
                    <ul class="tabs" role="tablist">
                        <li>
                            <button
                                class="active"
                                data-bs-toggle="tab"
                                data-bs-target="#product-information-tab"
                                type="button"
                            >Product Information</button>
                        </li>
                        <li>
                            <button
                                data-bs-toggle="tab"
                                data-bs-target="#usage-instructions-tab"
                                type="button"
                            >Usage Instructions</button>
                        </li>
                        <li>
                            <button
                                data-bs-toggle="tab"
                                data-bs-target="#product-claims-tab"
                                type="button"
                            >Product Claims</button>
                        </li>
                        <li>
                            <button
                                data-bs-toggle="tab"
                                data-bs-target="#content-requirements-tab"
                                type="button"
                            >Content Requirements <em>Must read</em></button>
                        </li>
                        <li>
                            <button
                                data-bs-toggle="tab"
                                data-bs-target="#creative-direction-tab"
                                type="button"
                            >Creative Direction</button>
                        </li>
                        <li>
                            <button
                                data-bs-toggle="tab"
                                data-bs-target="#content-examples-tab"
                                type="button"
                            >Content Examples</button>
                        </li>
                    </ul>
                </div>
            </div>
        </section>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                loadScriptOnce('guide-menu', 'sections/guide-menu/guide-menu.js');
            });
        </script>
    </div>
    <!-- GUIDE MENU END -->

    <!-- GUIDE CONTENT SECTIONS -->
    <div class="shopify-section shopify-section--guide-content">
        {{!-- <link rel="stylesheet" href="sections/guide-content/guide-content.css" /> --}}
        <section class="guide-content active" id="product-information-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#product-information-collapse"
                        aria-expanded="true"
                    >
                        Product Information
                    </button>
                    <div
                        id="product-information-collapse"
                        class="accordion-collapse show"
                    >
                        <article>
                            <h2>Product Information</h2>
                            <p>Blue+ is a lightweight, LED&#8209;enhancing serum designed to be applied before an LED session, working with your Q&#8209;Rejuvalight Pro to help skin respond more effectively to light — without increasing intensity, heat, or irritation.</p>
                            <p>Hero active:</p>
                            <ul>
                                <li><strong>USP Methylene Blue (0.1%)</strong> - a cosmetic photosensitizer that helps skin absorb and convert LED light into stronger cellular signaling, amplifying results from both Skin-Clearing (blue light) and Skin-Rejuvenating (red light) modes.</li>
                            </ul>
                            <p>Supporting actives:</p>
                            <ul>
                                <li><strong>Calendula iActive</strong> soothes and comforts skin, with added antioxidant support for skin exposed to daily screen/blue light</li>
                                <li><strong>Niacinamide</strong> supports a healthy-looking barrier and more even-looking tone</li>
                                <li><strong>Beta-Glucan</strong> helps soothe the appearance of skin</li>
                                <li><strong>Sodium Hyaluronate</strong> delivers lightweight hydration</li>
                                <li><strong>Bisabolol + Allantoin</strong> support skin comfort</li>
                                <li><strong>Vitamin E (Tocopheryl Acetate)</strong> provides antioxidant support</li>
                            </ul>
                        </article>
                        <div class="guide-link"><a href="#">Learn more about Qure Blue+ Face Serum</a></div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="shopify-section shopify-section--guide-content">
        <section class="guide-content" id="usage-instructions-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#usage-instructions-collapse"
                    >
                        Usage Instructions
                    </button>
                    <div
                        id="usage-instructions-collapse"
                        class="accordion-collapse"
                    >
                        <article>
                            <h2>Usage Instructions</h2>
                            <p><strong>How To Use (with Q-Rejuvalight Pro LED Mask):</strong></p>
                            <ol>
                                <li>Cleanse skin thoroughly.</li>
                                <li>Apply a pea-sized amount evenly to face and neck.</li>
                                <li>Allow a few minutes for absorption.</li>
                                <li>Apply the Q-Rejuvalight Pro LED Mask and run your selected treatment mode.</li>
                                <li>Do not rinse off — continue with your regular skincare routine after thse LED session.</li>
                            </ol>
                            <div class="c-note c-note--info">
                                <p><strong>Note:</strong> excess product may cause temporary staining — a pea-sized amount is all you need.</p>
                            </div>
                            <p><strong>How To Use (on its own):</strong></p>
                            <ol>
                                <li>Cleanse skin thoroughly.</li>
                                <li>Apply a pea-sized amount evenly to face and neck.</li>
                                <li>Massage in until fully absorbed.</li>
                                <li>Follow with your regular moisturizer or next skincare step.</li>
                            </ol>
                            <div class="c-note c-note--info">
                                <p>Can be used daily, with or without your LED session</p>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="shopify-section shopify-section--guide-content">
        <section class="guide-content" id="product-claims-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#product-claims-collapse"
                    >
                        Product Claims
                    </button>
                    <div
                        id="product-claims-collapse"
                        class="accordion-collapse"
                    >
                        <article>
                            <h2>Product Claims</h2>
                            <p>Key claims:</p>
                            <ul>
                                <li>Formulated to enhance the biological effectiveness of LED light, helping each session work harder without increasing intensity or irritation.</li>
                                <li>Powered by USP Methylene Blue, a cosmetic photosensitizer that amplifies results from both Skin-Clearing and Skin-Rejuvenating LED modes.</li>
                                <li>Supports a soothed, comfortable skin feel during and after LED use.</li>
                                <li>Dermatologically tested, hypoallergenic, and suitable for sensitive skin.</li>
                                <li>Fragrance-free, vegan, and cruelty-free.</li>
                            </ul>
                        </article>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="shopify-section shopify-section--guide-content">
        <section class="guide-content" id="content-requirements-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#content-requirements-collapse"
                    >
                        Content Requirements <em>Must read</em>
                    </button>
                    <div
                        id="content-requirements-collapse"
                        class="accordion-collapse"
                    >
                        <article>
                            <h2>Content Requirements</h2>
                            <p>Messaging must include:</p>
                            <ul>
                                <li>Blue+ can be used before your LED session — it's designed to enhance the Q-Rejuvalight Pro, or on it’s own.</li>
                                <li>Powered by USP Methylene Blue, a photosensitizer that helps skin respond more effectively to LED light.</li>
                                <li>Compatible with both Skin-Clearing (blue light) and Skin-Rejuvenating (red light) modes.</li>
                                <li>Lightweight, fast-absorbing, and non-irritating — safe for sensitive skin.</li>
                                <li>Do not rinse off before your LED session; continue your normal routine afterward.</li>
                                <li>Visible results build with consistent LED + Blue+ use.</li>
                            </ul>
                            <div class="c-note c-note--info">
                                <p>Remember to <strong>add a personal touch</strong> to the messaging, talk about how it feels going into your routine and any difference you've noticed in your sessions.</p>
                                <p>Examples:</p>
                                <ul>
                                    <li>“My LED sessions actually feel like they're doing more now.”</li>
                                    <li>“This is the step I never skip before my mask.”</li>
                                </ul>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="shopify-section shopify-section--guide-content">
        <section class="guide-content" id="creative-direction-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#creative-direction-collapse"
                    >
                        Creative Direction
                    </button>
                    <div
                        id="creative-direction-collapse"
                        class="accordion-collapse"
                    >
                        <article>
                            <h2>Creative Direction</h2>
                            <p>Recording Guidelines</p>
                            <ul>
                                <li>Use bright, natural lighting. No filters.</li>
                                <li>Please do not wear makeup (unless to show makeup removal).</li>
                                <li>Show the full routine: applying Blue+, then putting on the Q-Rejuvalight Pro LED Mask.</li>
                                <li>Keep backgrounds clean and uncluttered.</li>
                                <li>In cover photos, always show the serum in use (unless agreed otherwise).</li>
                                <li>Because the serum has a blue tint, a close-up of it on skin or on the applicator makes for a strong visual — feel free to highlight this.</li>
                            </ul>
                        </article>
                        <div
                            class="c-swiper"
                            data-swiper='{
                                "slidesPerView": 1.1,
                                "spaceBetween": 22,
                                "loop": false,
                                "pagination": {
                                    "el": ".c-swiper-pagination",
                                    "type": "custom"
                                },
                                "navigation": {
                                    "prevEl": ".c-swiper-button-prev",
                                    "nextEl": ".c-swiper-button-next"
                                },
                                "breakpoints": {
                                    "768": {
                                        "slidesPerView": 2
                                    }
                                }
                            }'
                        >
                            <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                    <picture>
                                        <img src="assets/images/blue-plus-face-serum/blue-plus-serum-brief-1.webp" alt="Blue+ Face Serum" />
                                    </picture>
                                </div>
                                <div class="swiper-slide">
                                    <picture>
                                        <img src="assets/images/blue-plus-face-serum/blue-plus-serum-brief-2.webp" alt="Blue+ Face Serum" />
                                    </picture>
                                </div>
                            </div>
                            <div class="c-swiper-nav">
                                <button class="c-swiper-button-prev"></button>
                                <div class="c-swiper-pagination"></div>
                                <button class="c-swiper-button-next"></button>
                            </div>
                        </div>
                        <div class="c-note c-note--info">
                            <p><strong>Tag and mention</strong> @qureskincare #QureSkincare #LEDtherapy #QureBluePlus</p>
                            <p>Include your affiliate or other links provided by Qure in Instagram Stories and content captions. If the link can't be placed in bio, include it in linktr.ee or similar.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="shopify-section shopify-section--guide-content">
        <section class="guide-content" id="content-examples-tab">
            <div class="container">
                <div class="accordion">
                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#content-examples-collapse"
                    >
                        Content Examples
                    </button>
                    <div
                        id="content-examples-collapse"
                        class="accordion-collapse"
                    >
                        <article>
                            <h2>Content Examples</h2>
                        </article>
                        <div
                            class="c-swiper"
                            data-swiper='{
                                "slidesPerView": 1.1,
                                "spaceBetween": 22,
                                "loop": false,
                                "pagination": {
                                    "el": ".c-swiper-pagination",
                                    "type": "custom"
                                },
                                "navigation": {
                                    "prevEl": ".c-swiper-button-prev",
                                    "nextEl": ".c-swiper-button-next"
                                },
                                "breakpoints": {
                                    "768": {
                                        "slidesPerView": 3.1
                                    }
                                }
                            }'
                        >
                            <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                    {{> c-wistia
                                        id="wuwofpexhl"
                                    }}
                                </div>
                                <div class="swiper-slide">
                                    {{> c-wistia
                                        id="fgpztdeimx"
                                    }}
                                </div>
                                <div class="swiper-slide">
                                    {{> c-wistia
                                        id="9kwcjxx5h5"
                                    }}
                                </div>
                            </div>
                            <div class="c-swiper-nav">
                                <button class="c-swiper-button-prev"></button>
                                <div class="c-swiper-pagination"></div>
                                <button class="c-swiper-button-next"></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                loadScriptOnce('guide-content', 'sections/guide-content/guide-content.js');
            });
        </script>
    </div>
    <!-- GUIDE CONTENT SECTIONS END -->

    <!-- BASE SECTION -->
    {{!-- <link rel="stylesheet" href="sections/base-section/base-section.css" /> --}}
    <section class="base-section base-section--small-media base-section--grey">
        <div class="container">
            <article>
                <h2>Trusted and Recommended by Experts</h2>
                <picture>
                    <img src="assets/images/experts/dr-shah-maxfield-2.webp" alt="Trusted and Recommended by Experts" />
                </picture>
                <div>
                    <p>“Methylene blue has been studied for how it interacts with cellular energy and light-dependent processes, making it <em>a great ingredient in skincare</em> designed for use with LED light therapy.”</p>
                </div>
                <div class="e-pill-badge">
                    <span class="e-checkmark"></span>
                    Dermatologist Reviewed
                </div>
            </article>
        </div>
    </section>
    <!-- BASE SECTION END -->
{{/default }}
