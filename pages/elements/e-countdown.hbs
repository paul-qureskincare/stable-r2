<div
    class="e-countdown"
    data-start-date="{{ start }}"
    data-offer-days="{{ days }}"
    {{#if color }} {{{ color }}} {{/if}}
>
    <div data-key="{{#if short }}d{{ else }}days{{/if}}">00</div>
    <div data-key="{{#if short }}h{{ else }}hours{{/if}}">00</div>
    <div data-key="{{#if short }}m{{ else }}minutes{{/if}}">00</div>
    <div data-key="{{#if short }}s{{ else }}seconds{{/if}}">00</div>
</div>
