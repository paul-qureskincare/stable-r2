<div
    class="
        e-bf-badge
        {{#if silver }}e-bf-badge--silver{{/if }}
        {{#if sm }}e-bf-badge--sm{{/if }}
        {{#if md }}e-bf-badge--md{{/if }}
        {{#if lg }}e-bf-badge--lg{{/if }}
    "
>
    <img
        src="assets/images/bf-26/{{#if silver }}bf-badge-silver{{/if }}.webp"
        alt="Black Friday"
    />
    <div class="e-bf-badge__content">
        {{#if before }}<span>{{ before }}</span>{{/if }}
        <strong>{{ value }}%</strong>
        {{#if after }}<span>{{ after }}</span>{{/if }}
    </div>
</div>
