<div class="e-expert-quote-tag">
    <span class="e-expert-quote-tag__avatar">
        <img src="{{ image }}" alt="{{ author }}" />
    </span>
    <span class="e-expert-quote-tag__text">
        <span class="e-expert-quote-tag__quote">{{ quote }}</span>
        <span class="e-expert-quote-tag__author"><strong>{{ author }}</strong> - {{ role }}</span>
    </span>
</div>
