<div
    class="e-ingredient-info"
    style="
        --percent: {{ percent }};
        {{#if color }} --accent-color: {{ color }};
        {{/if }}
    "
    data-percent="{{ percent }}"
>
    <div class="e-ingredient-info__row">
        <div class="e-ingredient-info__text">
            <h6>{{ name }}</h6>
            <p>{{ description }}</p>
        </div>
        <div class="e-ingredient-info__counter">0%</div>
    </div>
    <div class="e-ingredient-info__track">
        <div class="e-ingredient-info__fill"></div>
    </div>
</div>
