            <div class="tab-pane" id="elements">

                {{!-- e-icon --}}
                <section class="ui-el">
                    <h5>e-icon</h5>
                    <div class="ui-el__grid">
                        <figure>
                            <div class="ui-el__demo" style="font-size: 32px;">
                                {{> e-icon icon="cart" }}
                                {{> e-icon icon="user" }}
                                {{> e-icon icon="gift" }}
                            </div>
                            <figcaption>e-icon e-icon-{name} (full list on the Icons tab)</figcaption>
                        </figure>
                    </div>
                </section>

                {{!-- e-checkmark --}}
                <section class="ui-el">
                    <h5>e-checkmark</h5>
                    <div class="ui-el__grid">
                        <figure>
                            <div class="ui-el__demo" style="font-size: 24px;">
                                <div class="e-checkmark"></div>
                            </div>
                            <figcaption>size = font-size</figcaption>
                        </figure>
                    </div>
                </section>

                {{!-- e-pill-save --}}
                <section class="ui-el">
                    <h5>e-pill-save</h5>
                    <div class="ui-el__grid">
                        <figure>
                            <div class="ui-el__demo"><div class="e-pill-save">Save 52%</div></div>
                            <figcaption>default</figcaption>
                        </figure>
                        <figure>
                            <div class="ui-el__demo"><div class="e-pill-save e-pill-save--light">Save 52%</div></div>
                            <figcaption>--light</figcaption>
                        </figure>
                        <figure>
                            <div class="ui-el__demo"><div class="e-pill-save e-pill-save--bf">Save 52%</div></div>
                            <figcaption>--bf</figcaption>
                        </figure>
                        <figure>
                            <div class="ui-el__demo"><div class="e-pill-save" style="--e-pill-save-color: #008763;">Save 52%</div></div>
                            <figcaption>var --e-pill-save-color</figcaption>
                        </figure>
                    </div>
                </section>

                {{!-- e-pill-badge --}}
                <section class="ui-el">
                    <h5>e-pill-badge</h5>
                    <div class="ui-el__grid">
                        <figure>
                            <div class="ui-el__demo">
                                <div class="e-pill-badge">
                                    <span class="e-checkmark"></span>
                                    Dermatologist Reviewed
                                </div>
                            </div>
                            <figcaption>default</figcaption>
