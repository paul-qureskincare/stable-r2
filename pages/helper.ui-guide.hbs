    <script>
        // Live indicators for the Helpers tab (media queries and display classes)
        (function () {
            var px = document.querySelector("[data-live-px]");
            var mqItems = [].slice.call(document.querySelectorAll("[data-live-mq]"));
            function update() {
                if (px) px.textContent = window.innerWidth;
                mqItems.forEach(function (li) {
                    li.classList.toggle("is-on", window.matchMedia(li.dataset.liveMq).matches);
                });
            }

            window.addEventListener("resize", update);
            window.addEventListener("load", update);
            document.querySelectorAll('.nav-tabs [data-bs-toggle="tab"]').forEach(function (a) {
                a.addEventListener("click", function () { setTimeout(update, 50); });
            });
            update();
        })();

    </script>
    <script>
        // Keeps the active top-level tab in the URL hash, so a page refresh reopens the same tab
        (function () {
            var links = document.querySelectorAll(".nav-tabs .nav-link");

            links.forEach(function (link) {
                link.addEventListener("click", function () {
                    history.replaceState(null, "", link.getAttribute("href"));
                });
            });

            window.addEventListener("load", function () {
                var link = document.querySelector('.nav-tabs .nav-link[href="' + location.hash + '"]');
                if (link && !link.classList.contains("active")) link.click();
                window.scrollTo(0, 0);
            });
        })();

        // Plays the e-ingredient-info reveal for the demos (the real one lives in sections/experts-pick)
        document.querySelectorAll(".e-ingredient-info").forEach(function (item) {
            item.classList.add("e-ingredient-info--in-view");
            item.querySelector(".e-ingredient-info__counter").textContent = item.dataset.percent + "%";
        });
    </script>
