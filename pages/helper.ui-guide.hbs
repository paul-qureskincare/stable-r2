                <h5 class="ui-title">SCSS mixins (<code>mixins/_media.scss</code>)</h5>
                <table class="ui-table">
                    <thead><tr><th>Mixin</th><th>Media query</th><th>Meaning</th><th>Used</th></tr></thead>
                    <tbody>
                        <tr><th><code>@include sm { … }</code></th><td><code>@media screen and (max-width: 767px)</code></td><td>Mobile</td><td>1016</td></tr>
                        <tr><th><code>@include md { … }</code></th><td><code>@media screen and (max-width: 991px)</code></td><td>Tablet and below</td><td>270</td></tr>
                        <tr><th><code>@include lg { … }</code></th><td><code>@media screen and (max-width: 1120px)</code></td><td>Small laptop and below</td><td>25</td></tr>
                        <tr><th><code>@include xl { … }</code></th><td><code>@media screen and (max-width: 1199px)</code></td><td>Laptop and below</td><td>17</td></tr>
                        <tr><th><code>@include hover { … }</code></th><td><code>@media (hover: hover) { &:hover { … } }</code></td><td>Hover only on devices with a mouse</td><td>25</td></tr>
                    </tbody>
                </table>
                <p class="ui-el__note">Mixins are <strong>desktop-first</strong> (<code>max-width</code>). Use them via <code>@use "@root/mixins" as *;</code>.</p>

