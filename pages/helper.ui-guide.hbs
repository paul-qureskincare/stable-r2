                    <thead><tr><th>Variable</th><th>Color</th><th>Specimen</th><th>Usage</th></tr></thead>
                    <tbody>
                        <tr><th><code>--heading-color / --qure-charcoal</code></th><td><span class="ui-swatch" style="background:#212428"></span> <code>#212428</code></td><td><div class="ui-specimen" style="color:#212428;font-weight:500">Aa &mdash; The quick brown fox jumps</div></td><td>Headings, main text</td></tr>
                        <tr><th><code>--charcoal-light / --border-color</code></th><td><span class="ui-swatch" style="background:#8b8c8e"></span> <code>#8b8c8e</code></td><td><div class="ui-specimen" style="color:#8b8c8e;font-weight:500">Aa &mdash; The quick brown fox jumps</div></td><td>Secondary text, disclaimers</td></tr>
                        <tr><th><code>--color-green</code></th><td><span class="ui-swatch" style="background:#008763"></span> <code>#008763</code></td><td><div class="ui-specimen" style="color:#008763;font-weight:500">Aa &mdash; The quick brown fox jumps</div></td><td>Success, accent</td></tr>
