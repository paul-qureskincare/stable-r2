                        <tr><th><code>--base-color</code></th><td><span class="ui-swatch" style="background:#c8e6dc"></span> <code>#c8e6dc</code></td><td><div class="ui-specimen" style="color:#c8e6dc;font-weight:500">Aa &mdash; The quick brown fox jumps</div></td><td>Mint accent</td></tr>
                        <tr><th><code>--white-color</code></th><td><span class="ui-swatch" style="background:#fff"></span> <code>#fff</code></td><td class="is-dark"><div class="ui-specimen" style="color:#fff;font-weight:500">Aa &mdash; The quick brown fox jumps</div></td><td>On dark backgrounds</td></tr>
