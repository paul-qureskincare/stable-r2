        <div class="hero-product__main">
            <h1>The Micro Infusion Anti&#8209;Aging&nbsp;System™</h1>
            <p>Reveal the appearance of <strong>firmer, younger &amp; more even-looking skin</strong> in just a few, easy at-home applications or <strong>get your money back!*</strong></p>
            {{> c-rating
                light=true
                trustpilot=true
                value="4.8"
            }}
            <article>
                <ul>
                    <li>
                        {{> e-icon icon="balances" }}
                        Supports natural collagen production
                    </li>
                    <li>
                        {{> e-icon icon="double-drop" }}
                        Increases serums absorption
                    </li>
                    <li>
                        {{> e-icon icon="verified-shield" }}
                        See visible results after one treatment
                    </li>
                    <li>
                        {{> e-icon icon="certificate" }}
                        Recommended by Dermatoligists
                    </li>
                </ul>
            </article>
            {{> c-options-selector
                title="Select Your Serum"
                list='[
                    {
                        "img": "assets/images/micro-infusion-pdp/serum_1_new.webp",
                        "name": "Dark Spots",
                        "option": "serum",
                        "checked": true
                    },
