{{#> default
    title="Recovery+ Sheet Mask"
    body-class="product.recovery-sheet-mask"
    page-css=true
}}
    {{#> hero-product }}
        <div class="hero-product__gallery">
            <div
                class="c-swiper"
                data-swiper-thumbs="#hero-product .c-swiper-thumbs"
                data-swiper='{
                    "slidesPerView": 1,
                    "spaceBetween": 16,
                    "navigation": {
                        "prevEl": "#hero-product .c-swiper-button-prev",
                        "nextEl": "#hero-product .c-swiper-button-next"
                    }
                }'
            >
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <img src="assets/images/recovery-mask/mask-big-tile-1.webp" alt="Recovery+ Sheet Mask" />
                    </div>
                    <div class="swiper-slide">
                        <img src="assets/images/recovery-mask/mask-big-tile-3.webp" alt="Recovery+ Sheet Mask" />
                    </div>
                    <div class="swiper-slide">
                        <img src="assets/images/recovery-mask/mask-big-tile-4.webp" alt="Recovery+ Sheet Mask" />
                    </div>
                </div>
            </div>
            <div class="c-swiper-thumbs-nav">
                <button class="c-swiper-button-prev"></button>
                <div
                    class="c-swiper c-swiper-thumbs"
                    data-swiper='{
                        "slidesPerView": "auto",
                        "spaceBetween": 12
                    }'
                >
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="assets/images/recovery-mask/mask-big-tile-1.webp" alt="Recovery+ Sheet Mask" />
                        </div>
                        <div class="swiper-slide">
                            <img src="assets/images/recovery-mask/mask-big-tile-3.webp" alt="Recovery+ Sheet Mask" />
                        </div>
                        <div class="swiper-slide">
                            <img src="assets/images/recovery-mask/mask-big-tile-4.webp" alt="Recovery+ Sheet Mask" />
                        </div>
                    </div>
                </div>
                <button class="c-swiper-button-next"></button>
            </div>
        </div>
        <div class="hero-product__main">
            {{> c-rating value="4.8" reviews="10,324" light=true }}
            <h1>Recovery+ Sheet Mask</h1>
            <article>
                <p>An intensive, serum-soaked mask with <strong>Polyglutamic Acid, Beta-Glucan, Cica &amp; Ectoin</strong> to replenish dry, freshly-treated skin.</p>
                <ul>
                    <li>Helps calm <strong>visible redness</strong> and support the skin barrier</li>
                    <li>Floods skin with <strong>moisture</strong>, leaving it soft, replenished, and comfortable.</li>
                    <li>A cooling <strong>15–20 minute</strong> reset, after Micro-Infusion or whenever skin needs extra care.</li>
                </ul>
            </article>
            {{> c-supply-selector
                classes=""
                title="Subscribe & Save:"
                list='[
                    {
                        "image": "assets/images/recovery-mask/mask-supply-3.webp",
                        "name": "3 Month Supply",
                        "desc": "1 box 6 masks <small>Ships every 3 months</small>",
                        "price-old": true,
                        "save-pill": true,
                        "save-value": "{dyn}% OFF",
                        "tag-up": false,
                        "tag-name": "Best Results",
                        "option": "subscribe",
                        "checked": true
                    }
                ]'
            }}
            <div class="c-buy-block">
                {{> c-order-button }}
                <div class="c-selector-switcher c-selector-switcher--text">
                    <ul class="e-pill-tabs e-pill-tabs--selector">
                        <li>
                            <label>
                                <input name="delivery-type" type="radio" />
                                One Time Purchase {$dyn}
                            </label>
                        </li>
                        <li>
                            <label>
                                <input name="delivery-type" type="radio" checked />
                                Subscribe &amp; Save
                            </label>
                        </li>
                    </ul>
                    <p>{{> e-icon icon="rotation-2" }} Auto-ships · Cancel anytime · No commitment</p>
                </div>
