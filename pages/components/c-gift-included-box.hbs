<div class="c-gift-included-box">
    <div class="e-pill-save">{{badge}}</div>
    <div class="c-gift-included-box__content">
        <img src="{{image}}" alt="{{title}}" />
        <div>
            <strong>{{{title}}}</strong>
            <span>{{{description}}}</span>
        </div>
        <p>
            <span>{{{label}}}</span>
            <span>{{{price}}}</span>
        </p>
    </div>
</div>
