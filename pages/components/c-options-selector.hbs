<div class="c-options-selector
    {{#if line }}c-options-selector--line{{/if }}
    {{#if color }}c-options-selector--color{{/if }}
">
    <p class="c-options-selector__title">{{ title }}:</p>
    <ul class="c-options-selector__list">
        {{#parseJson list }}
            <li>
                <label>
                    <input
                        type="radio"
                        name="{{ option }}"
                        {{#if value }}value="{{ value }}"{{/if}}
                        {{#if checked }}checked{{/if}}
                    />
                    {{#if img2 }}
                        <div class="bundle">
                            <figure>
                                <img src="{{ img }}" alt="{{ name }}" />
                            </figure>
                            {{> e-icon icon="plus" }}
                            <figure>
                                <img src="{{ img2 }}" alt="{{ name }}" />
                                <figcaption class="e-pill-badge e-pill-badge--xxs">Free</figcaption>
                            </figure>
                        </div>
                    {{ else }}
                        {{#if img }}
                            <img src="{{ img }}" alt="{{ name }}" />
                        {{/if }}
                    {{/if }}
                    <span>{{ name }}</span>
                    {{#if tooltip }}
                        {{> c-info
                            content=tooltip
                        }}
                    {{/if }}
                </label>
            </li>
        {{/parseJson}}
    </ul>
    {{#unless hide-notify }}
        <button class="btn btn--sm btn--secondary" type="button" onclick="notifyAvailable.showModal()">Notify Me When Available</button>
    {{/unless }}
</div>
