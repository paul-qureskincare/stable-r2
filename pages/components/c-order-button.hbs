<div class="c-order-button">
    <button class="btn btn--primary" type="button" {{#if on-click }}onclick="{{ on-click }}"{{/if }}>
        {{#if button }}
           {{ button }}
        {{ else }}
            Buy Now
        {{/if}}
        {{#if arrow }} {{> e-icon icon="arrow" }} {{/if }}
    </button>
    {{#if subscription-details }}
        <p><strong>Skip, pause/modify or cancel anytime.</strong> <a href="#">See more details.</a></p>
    {{/if }}
    {{#unless hide-pay }}
        {{> e-pay-options
            pay-options-label=pay-options-label
        }}
    {{/unless}}
</div>
