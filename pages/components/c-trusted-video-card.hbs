<div class="c-trusted-video-card">
    {{> c-wistia
        id=id
        custom=(concat '<picture><img src="' thumbnail '" alt="' dr '" /></picture><div class="e-pill-badge e-pill-badge--md">' followers ' Followers</div>')
    }}
    <article>
        <p>"{{ text }}"</p>
        <div>
            <p>{{ dr }}</p>
            <p><span class="e-checkmark"></span> {{ position }}</p>
        </div>
    </article>
</div>
