<div class="
    c-rating
    {{#unless light }}c-rating--bg{{/unless }}
    {{#if trustpilot }}c-rating--trustpilot{{/if }}
">
    <div class="e-rating-stars" style="--rating: {{#if value }}{{ value }}{{else}}4.5{{/if }};"></div>
    {{#if custom }}
        <span>{{ custom }} {{#if value }}<strong>{{ value }}</strong>/5{{/if }}</span>
    {{ else }}
        <a href="#"><strong>{{ value }}</strong>/5 Rated by Customers</a>
    {{/if }}
    {{#if trustpilot }}
        <img src="assets/images/trustpilot.webp" alt="Trustpilot" />
    {{/if }}
</div>
