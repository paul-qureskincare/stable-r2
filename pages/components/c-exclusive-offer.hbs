<div class="c-exclusive-offer">
    <div class="c-exclusive-offer__tag">
        <div class="e-double-tag"><strong>{{ tag-first }}</strong> {{ tag-second }}</div>
    </div>
    <div class="c-exclusive-offer__list">
        <div class="c-exclusive-offer__item">
            <img src="{{ img-first }}" alt="{{ tag-first }} {{ tag-second }}" />
            <div>${dyn}</div>
        </div>
        {{> e-icon icon="plus" }}
        <div class="c-exclusive-offer__item">
            <img src="{{ img-second }}" alt="{{ tag-first }} {{ tag-second }}" />
            <div><del>${dyn}</del> <strong>Free</strong></div>
        </div>
    </div>
    <p class="c-exclusive-offer__desc">{{ text }}</p>
</div>
