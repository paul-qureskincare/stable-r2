<div class="c-complete-bundle">
    <p>
        <strong>{{ title }}</strong>
        {{ text }}
    </p>
    <figure>
        <img src="{{ first-image }}" alt="First bundle image" />
        <figcaption class="e-pill-badge e-pill-badge--sm">{$dyn}</figcaption>
    </figure>
    {{> e-icon icon="plus" }}
    <figure>
        <img src="{{ second-image }}" alt="Second bundle image" />
        <figcaption class="e-pill-badge e-pill-badge--sm">
            <del>{$dyn}</del>
            <strong>Free</strong>
        </figcaption>
    </figure>
    {{#if progress-bar }}
        {{> e-progress
            label="Limited Time Offer, While Supplies Last"
            progress="60"
        }}
    {{/if }}
</div>
