<div
    class="c-special-offer{{#if bf }} c-special-offer--bf{{/if }}"
    {{#unless hide-label }} data-label="{{#if label }}{{ label }}{{ else }}Special Offer{{/if }}"{{/unless }}
>
    {{#unless hide-price }}
        {{> e-price current="{$dyn}" old="{$dyn}" }}
    {{/unless}}
