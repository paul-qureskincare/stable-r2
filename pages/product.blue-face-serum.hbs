                        "text": "
                            <p>
                                <strong>Methylene Blue</strong><br />
                                A cosmetic photosensitizer and antioxidant used to enhance how skin responds to light-based treatments.
                            </p>

                            <p>
                                <strong>Calendula iActive</strong><br />
