{{#> default
    title="Micro Infusion Hair"
    body-class="page.qure-microinfusion-hair-offer"
    page-css=true
}}
    {{#> hero-section
        classes=""
    }}
        <picture class="hero-section__image">
            <source media="(min-width:768px)" srcset="sections/hero-section/images/micro-infusion-hair.webp" />
            <img src="sections/hero-section/images/micro-infusion-hair-mob.webp" alt="Micro-Infusion Hair" />
        </picture>
        <article class="hero-section__content">
            <div class="hero-section__content-header">
                {{> c-approved-by
                    custom="<p>100+ dermatologists <span>&bull;</span> <a href=\"#\"><strong>4.7/5</strong></a> 750k+ customers</p>"
                }}
                <p>The Perfect Pair, Bundled Together</p>
                <h1>Two Steps to Visibly <br /> Fuller-Looking Hair </h1>
                <p><strong>Pair the Micro-Infusion Pro Hair System with Hair Renewal Serum</strong> for a simple, science-backed routine.</p>
            </div>
            <div class="hero-section__content-other">
                {{> e-expert-quote-tag
                    image="assets/images/experts/expert-quote-tag.webp"
                    quote="\"A clinic-inspired approach to scalp health, right at home.\""
                    author="Dr.Shah"
                    role="Board-Certified Dermatologist"
                }}
            </div>
            <div class="hero-section__content-button">
                <a href="#buy_box" class="btn btn--primary">Start My Hair Transformation</a>
            </div>
            <div class="hero-section__content-other">
                {{> e-short-features-list
                    list='[
                        {
                            "icon": "micro-stamping",
                            "name": "Precision Micro-Stamping Technology"
                        },
                        {
                            "icon": "hair",
                            "name": "Targets the Look<br /> of Thinning"
                        },
                        {
                            "icon": "smooths",
                            "name": "Designed to Work Better Together"
                        }
                    ]'
                }}
            </div>
        </article>
    {{/hero-section }}

    {{> board-advisors
        title="Trusted and Recommended by Skin Experts"
        advisory-1="This treatment is an at-home option for those who want to avoid the hassle or cost of going to the office"
        advisory-2="Qure do studies on this, taking a look at how effective it is, so you can have confidence it’s going to help what you’re doing for your skincare routine"
        advisory-3="I love that Qure Skincare products go beyond just topical treatments, helping to maintain the results of in-office procedures"
        advisory-4="The Qure Micro-Infusion stamping device offers a safe and effective solution for a variety of different skin conditions"
    }}

    {{#> base-section
        classes="base-section--haircare"
        title="Go beyond surface-level haircare"
        c-wistia="jhwgazmjv8"
        c-wistia-inline=true
        c-wistia-hide-panel=true
    }}
        <p>Traditional serums sit on top of the scalp or rinse away. Once a week, the Micro-Infusion Pro Hair System uses 0.5mm 24k gold-plated needles to create tiny micro-channels, <strong>designed to help deliver serum actives directly to the scalp surface where they're needed most.</strong> On the days in between, the Hair Renewal Serum keeps your scalp conditioned.</p>
        <p>The patent-pending system uses tiny, virtually painless, microneedles penetrate beyond the skin’s surface increasing serum absorption and delivering powerful active ingredients exactly where they’re needed!</p>
        <p><strong>How Qure refreshes your skin in 3 easy steps:</strong></p>
        <ul class="e-steps-list">
            <li>
                <strong>Stamp</strong>
                <p>Virtually painless micro-stamping with 0.5mm needles on a sterile, single-use tip.</p>
            </li>
            <li>
                <strong>Infuse</strong>
                <p>Designed to help deliver serum actives directly to the scalp surface.</p>
            </li>
            <li>
                <strong>Renews</strong>
                <p>Supports the look of fuller, denser-looking hair over time.</p>
            </li>
        </ul>
    {{/base-section }}

    {{#> bundled-together }}
        <h2>The Micro-Infusion Pro Hair System + Hair Renewal Serum</h2>
        <div class="c-product-components c-product-components--hair">
            <picture>
                <img src="assets/images/hair/mi-hair-bungle.webp" alt="The Micro-Infusion Pro Hair System + Hair Renewal Serum" />
            </picture>
            <div class="e-component-pointer">
                <hr />
                <div>
                    <strong>Hair Renewal Serum <span class="e-pill-badge e-pill-badge--xxs">Nightly</span></strong>
                    <small>Helps provide lasting scalp hydration</small>
                </div>
            </div>
            <div class="e-component-pointer">
                <hr />
                <div>
                    <strong>Micro-Infusion Pro Hair <span class="e-pill-badge e-pill-badge--xxs">Weekly</span></strong>
                    <small>Helps target the appearance of thinning areas</small>
                </div>
            </div>
            <div class="e-component-pointer">
                <hr />
                <div>
                    <strong>Together <span class="e-pill-badge e-pill-badge--xxs">Weekly + Nightly</span></strong>
                    <small>Visibly fuller, more resilient-looking hair</small>
                </div>
            </div>
        </div>
        {{> e-quote-card
            image="assets/images/experts/dr-shah-quote.webp"
            quote="It's a simple, at-home system that is both quick and highly effective."
            name="Dr. Shah"
            position="Dermatologist"
        }}
        <a href="#buy_box" class="btn btn--primary">Shop Now</a>
    {{/bundled-together }}

    {{#> mi-ingredients }}
        <article class="mi-ingredients__text">
            <h2>Two products. Complete care.</h2>
            <p>Use Micro-Infusion Pro weekly, and Hair Renewal Serum nightly, for complete scalp care.</p>
        </article>
        <div class="mi-ingredients__card">
            <img src="sections/mi-ingredients/images/mi-2-device-rejuvenating-1.webp" alt="Thinning Areas" />
            <article>
                <span class="e-pill-badge e-pill-badge--xxs e-pill-badge--fill">Weekly</span>
                <h3>Thinning Areas</h3>
                <h6>MICRO-INFUSION PRO HAIR SYSTEM</h6>
                <p>Creates precise micro-channels at the scalp surface to help deliver serum actives where they’re needed.</p>
                <ul>
                    <li>
                        {{> e-icon icon="hair" }}
                        Targets the look of thinning
                    </li>
                    <li>
                        {{> e-icon icon="micro-stamping" }}
                        Supports denser, fuller-looking hair
                    </li>
                    <li>
                        {{> e-icon icon="fast" }}
                        5-minute weekly treatment
                    </li>
                </ul>
            </article>
            {{> c-accordion
                type="lines"
                list='[
                    {
                        "summary": "All Ingredients",
                        "text": "
                            <p>Pisum Sativum (Pea) Sprout Extract<br /> Helps target the look of thinning, for visibly denser-looking hair.</p>
                            <p>Acetyl Tetrapeptide-3 / Clover Flower Extract<br /> Helps improve the appearance of scalp vitality and hair fullness.</p>
                            <p>Copper Tripeptide-1<br /> Supports the look of stronger, resilient-looking hair.</p>
                            <p>Niacinamide<br /> Helps condition and hydrate the scalp.</p>
                            <p>Caffeine<br /> Provides an energizing, invigorating sensation on the scalp.</p>
                            <p>Larix / Green Tea / Zinc / Glycine Complex<br /> Helps the scalp look and feel more balanced with regular use.</p>
                            <p>Pyrrolidinyl Diaminopyrimidine Oxide<br /> Supports the look of smoother, more resilient-looking strands.</p>
                            <p>Dihydroxypropyl Arginine HCl<br /> Supports a smoother, more comfortable-feeling scalp.</p>
                            <small>Please note that due to innovative updates and changing regulatory guidelines, the ingredient lists provided here may differ slightly from those on our packaging and distributor websites.</small>
                        "
                    }
                ]'
            }}
        </div>
        <div class="mi-ingredients__card">
            <img src="sections/mi-ingredients/images/mi-2-device-rejuvenating-2.webp" alt="Scalp Hydration" />
            <article>
                <span class="e-pill-badge e-pill-badge--xxs e-pill-badge--fill">Nightly</span>
                <h3>Scalp Hydration</h3>
                <h6>HAIR RENEWAL SERUM</h6>
                <p>A lightweight, dropper-applied serum for nightly use on non-infusion nights.</p>
                <ul>
                    <li>
                        {{> e-icon icon="smooths" }}
                        Conditions &amp; hydrates scalp
                    </li>
                    <li>
                        {{> e-icon icon="cooling" }}
                        Invigorating, cooling feel
                    </li>
                    <li>
                        {{> e-icon icon="deeply-hydrates" }}
                        Antioxidant-rich formula
                    </li>
                </ul>
            </article>
            {{> c-accordion
                type="lines"
                list='[
                    {
                        "summary": "All Ingredients",
                        "text": "
                            <p>Pisum Sativum (Pea) Sprout Extract<br /> Helps target the look of thinning, for visibly denser-looking hair.</p>
                            <p>Acetyl Tetrapeptide-3 / Clover Flower Extract<br /> Helps improve the appearance of scalp vitality and hair fullness.</p>
                            <p>Copper Tripeptide-1<br /> Supports the look of stronger, resilient-looking hair.</p>
                            <p>Niacinamide<br /> Helps condition and hydrate the scalp.</p>
                            <p>Caffeine<br /> Provides an energizing, invigorating sensation on the scalp.</p>
                            <p>Larix / Green Tea / Zinc / Glycine Complex<br /> Helps the scalp look and feel more balanced with regular use.</p>
                            <p>Pyrrolidinyl Diaminopyrimidine Oxide<br /> Supports the look of smoother, more resilient-looking strands.</p>
                            <p>Dihydroxypropyl Arginine HCl<br /> Supports a smoother, more comfortable-feeling scalp.</p>
                            <p>Peppermint Oil (Hair Renewal Serum only)<br /> Delivers a cooling, refreshing feel on application.</p>
                            <small>Please note that due to innovative updates and changing regulatory guidelines, the ingredient lists provided here may differ slightly from those on our packaging and distributor websites.</small>
                        "
                    }
                ]'
            }}
        </div>
        <div class="mi-ingredients__button">
            {{> c-order-button
                button="Add Full System to Cart"
                hide-pay=true
            }}
            <small>30-Day Money-Back Guarantee &bull; Free US Shipping</small>
        </div>
    {{/mi-ingredients }}

    {{#> routine-steps }}
        <hgroup class="routine-steps__titles">
            <h6>HOW TO USE</h6>
            <h2>Your 5-Minute Weekly Routine</h2>
        </hgroup>
        <div class="routine-steps__swiper">
            <strong>Micro-Infusion Pro Hair System</strong>
            <div class="e-pill-badge e-pill-badge--xs e-pill-badge--fill">Weekly</div>
            <div
                class="c-swiper"
                data-swiper='{
                    "slidesPerView": 1.2,
                    "spaceBetween": 16,
                    "loop": false,
                    "pagination": {
                        "el": ".c-swiper-pagination",
                        "type": "custom"
                    },
                    "navigation": {
                        "prevEl": ".c-swiper-button-prev",
                        "nextEl": ".c-swiper-button-next"
                    },
                    "breakpoints": {
                        "768": {
                            "slidesPerView": 3
                        }
                    }
                }'
            >
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <picture data-index="1">
                            <img src="sections/routine-steps/images/mi-hair-system-1.svg" alt="1. Remove the cap. Sterile, single-use." />
                        </picture>
                        <p>Remove the cap. Sterile, single-use.</p>
                    </div>
                    <div class="swiper-slide">
                        <picture data-index="2">
                            <img src="sections/routine-steps/images/mi-hair-system-2.svg" alt="2. Stamp on clean, dry scalp." />
                        </picture>
                        <p>Stamp on clean, dry scalp.</p>
                    </div>
                    <div class="swiper-slide">
                        <picture data-index="3">
                            <img src="sections/routine-steps/images/mi-hair-system-3.svg" alt="3. Finish with any remaining serum." />
                        </picture>
                        <p>Finish with any remaining serum.</p>
                    </div>
                </div>
                <div class="c-swiper-nav">
                    <button class="c-swiper-button-prev"></button>
                    <div class="c-swiper-pagination"></div>
                    <button class="c-swiper-button-next"></button>
                </div>
            </div>
        </div>
        <div class="routine-steps__swiper">
            <strong>Hair Renewal Serum</strong>
            <div class="e-pill-badge e-pill-badge--xs e-pill-badge--fill">Nightly</div>
            <div
                class="c-swiper"
                data-swiper='{
                    "slidesPerView": 1.2,
                    "spaceBetween": 16,
                    "loop": false,
                    "pagination": {
                        "el": ".c-swiper-pagination",
                        "type": "custom"
                    },
                    "navigation": {
                        "prevEl": ".c-swiper-button-prev",
                        "nextEl": ".c-swiper-button-next"
                    },
                    "breakpoints": {
                        "768": {
                            "slidesPerView": 2
                        }
                    }
                }'
            >
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <picture data-index="1">
                            <img src="sections/routine-steps/images/hair-renewal-serum-1.svg" alt="1. Unscrew the cap and lift out the dropper." />
                        </picture>
                        <p>Unscrew the cap and lift out the dropper.</p>
                    </div>
                    <div class="swiper-slide">
                        <picture data-index="2">
                            <img src="sections/routine-steps/images/hair-renewal-serum-2.svg" alt="2. Massage 4-6 drops into your scalp. No rinse." />
                        </picture>
                        <p>Massage 4-6 drops into your scalp. No rinse.</p>
                    </div>
                </div>
                <div class="c-swiper-nav">
                    <button class="c-swiper-button-prev"></button>
                    <div class="c-swiper-pagination"></div>
                    <button class="c-swiper-button-next"></button>
                </div>
            </div>
        </div>
    {{/routine-steps }}

    {{#> usage-steps }}
        <div class="container">
            <article>
                <h2>Step by step</h2>
                {{> c-wistia
                    id="jhwgazmjv8"
