                    "spaceBetween": 16,
                    "loop": false,
                    "pagination": {
                        "el": ".c-swiper-pagination",
                        "type": "custom"
                    },
                    "navigation": {
                        "prevEl": ".c-swiper-button-prev",
                        "nextEl": ".c-swiper-button-next"
                    },
                    "breakpoints": {
                        "768": {
                            "slidesPerView": 2.2,
                            "spaceBetween": 24
                        }
                    }
                }'
            >
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <picture data-index="1">
                            <source media="(min-width:768px)" srcset="sections/usage-steps/images/usage-steps-hair-bundle-1.webp" />
                            <img src="sections/usage-steps/images/usage-steps-hair-bundle-1-mob.webp" alt="1. Prepare" />
                        </picture>
                        <article>
                            <h6>1. Prepare</h6>
                            <p>Start with a clean, dry scalp so the needle head glides smoothly.</p>
                        </article>
                    </div>
                    <div class="swiper-slide">
                        <picture data-index="2">
                            <source media="(min-width:768px)" srcset="sections/usage-steps/images/usage-steps-hair-bundle-2.webp" />
                            <img src="sections/usage-steps/images/usage-steps-hair-bundle-2-mob.webp" alt="2. Micro-Infusion Pro Hair System" />
                        </picture>
                        <article>
                            <h6>2. Micro-Infusion Pro Hair System</h6>
                            <p>Once a week, gently stamp the device across your scalp to help the Micro-Infusion Hair Serum reach the scalp surface.</p>
                        </article>
                    </div>
                    <div class="swiper-slide">
                        <picture data-index="3">
                            <source media="(min-width:768px)" srcset="sections/usage-steps/images/usage-steps-hair-bundle-3.webp" />
                            <img src="sections/usage-steps/images/usage-steps-hair-bundle-3-mob.webp" alt="3. Hair Renewal Serum" />
                        </picture>
                        <article>
                            <h6>3. Hair Renewal Serum</h6>
                            <p>On nights in between, massage a few drops into your scalp to keep it conditioned.</p>
                        </article>
                    </div>
                </div>
                <div class="c-swiper-nav">
                    <button class="c-swiper-button-prev"></button>
                    <div class="c-swiper-pagination"></div>
                    <button class="c-swiper-button-next"></button>
                </div>
            </div>
        </div>
    {{/usage-steps }}

