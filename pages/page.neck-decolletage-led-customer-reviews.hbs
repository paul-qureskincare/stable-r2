{{#> default
    title="Neck & Décolletage reviews"
    body-class="page.neck-decolletage-led-customer-reviews"
    page-css=true
}}
    <!-- ACROSS IMAGE BANNER -->
    {{!-- <link rel="stylesheet" href="sections/across-image-banner/across-image-banner.css" /> --}}
    <section class="across-image-banner across-image-banner--hero">
        <picture>
            <source media="(min-width:768px)" srcset="assets/images/page-banner/customer_reviews_banner.webp" />
            <img src="assets/images/page-banner/customer_reviews_banner_mob.webp" alt="500K+ Happy Customers" />
        </picture>
        <div class="container">
            <article>
                <h1>500K+ Happy Customers</h1>
                <div class="trustpilot-rating">
                    <ul>
                        <li><i class="e-icon e-icon-trustpilot"></i></li>
                        <li><i class="e-icon e-icon-trustpilot"></i></li>
                        <li><i class="e-icon e-icon-trustpilot"></i></li>
                        <li><i class="e-icon e-icon-trustpilot"></i></li>
                        <li><i class="e-icon e-icon-trustpilot"></i></li>
                    </ul>
                    <div>Rated <strong>Great</strong> on Trustpilot</div>
                </div>
            </article>
        </div>
    </section>
    <!-- ACROSS IMAGE BANNER END -->

    <!-- PILLS NAVIGATION -->
    {{!-- <link rel="stylesheet" href="sections/pills-nav/pills-nav.css" /> --}}
    <section class="pills-nav">
        <div class="container">
            <div class="pills-nav__header">
                <span>Filter by product</span>
                <div>Swipe for more <i class="e-icon e-icon-arrow"></i></div>
            </div>
            <ul class="c-pills-nav">
                <li><a href="page.reviews.html">Micro-Infusion System</a></li>
                <li><a href="page.q-rejuvalight-pro-customer-reviews.html">Q-Rejuvalight Pro</a></li>
                <li><a href="page.neck-decolletage-led-customer-reviews.html" class="active">Neck & Décolletage LED System</a></li>
                <li><a href="page.all-in-one-serum-customer-reviews.html">All-In-One Serum</a></li>
                <li><a href="page.micro-infusion-targeted-patches-customer-reviews.html">Micro-Infusion Targeted Patches</a></li>
            </ul>
        </div>
    </section>
    <!-- PILLS NAVIGATION END -->

    <!-- SECTIONS SUB-STACK -->
    <div class="sections-stack__sub-stack">
        <!-- BASE SLIDER -->
        {{!-- <link rel="stylesheet" href="sections/base-slider/base-slider.css" /> --}}
        <section class="base-slider">
            <div class="container">
                <div
                    class="c-swiper"
                    data-swiper='{
                        "slidesPerView": 1.2,
                        "spaceBetween": 16,
                        "loop": false,
                        "pagination": {
                            "el": ".c-swiper-pagination",
                            "type": "custom"
                        },
                        "navigation": {
                            "prevEl": ".c-swiper-button-prev",
                            "nextEl": ".c-swiper-button-next"
                        },
                        "breakpoints": {
                            "480": {
                                "slidesPerView": 2.2
                            },
                            "768": {
                                "slidesPerView": 4
                            }
                        }
                    }'
                >
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="rffwioglk5"
                                inert=true
                            }}
                        </div>
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="kcob5mwt5z"
                                inert=true
                            }}
                        </div>
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="yrv6jnsupt"
                                inert=true
                            }}
                        </div>
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="tcamr8isle"
                                inert=true
                            }}
                        </div>
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="ob6b7i5vdo"
                                inert=true
                            }}
                        </div>
                        <div class="swiper-slide">
                            {{> c-wistia
                                id="ha3jsau5v8"
                                inert=true
                            }}
                        </div>
                    </div>
                    <div class="c-swiper-nav">
                        <button class="c-swiper-button-prev"></button>
                        <div class="c-swiper-pagination"></div>
                        <button class="c-swiper-button-next"></button>
                    </div>
                </div>
            </div>
        </section>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                loadScriptOnce('base-slider', 'sections/base-slider/base-slider.js');
            });
        </script>
        <!-- BASE SLIDER END -->

        <!-- BASE SLIDER -->
        {{!-- <link rel="stylesheet" href="sections/base-slider/base-slider.css" /> --}}
